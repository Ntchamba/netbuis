# Modèle des variables de la pile VPS. install.sh crée le vrai fichier `.env` (droits 600) ;
# NE JAMAIS le versionner ni en copier le contenu dans un message. Valeurs ci-dessous = exemples vides.
DOMAINE=
ACME_EMAIL=
# Générés par install.sh (openssl rand) :
POSTGRES_PASSWORD=
SECRET_KEY=
# Fournisseur de SMS : « real » (le fournisseur réel reste à choisir : décision D-02). « console » est refusé en production.
SMS_PROVIDER=real
SMS_API_KEY=
# Renseignés par jitsi.sh (vides = appels refusés) :
JITSI_DOMAIN=
JITSI_APP_ID=
JITSI_JWT_SECRET=
