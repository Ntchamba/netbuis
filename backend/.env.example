# Copier en backend/.env — ce fichier ne contient AUCUN secret réel.
DEBUG=True
SECRET_KEY=dev-only-insecure-key-change-me
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://UTILISATEUR:change-me@localhost:5432/netbuis
CORS_ALLOWED_ORIGINS=http://localhost:5173

# SMS (OTP) : console (développement, exige DEBUG=True) | real (fournisseur réel, pas encore choisi)
SMS_PROVIDER=console
# Clé du fournisseur SMS réel : à remplir PLUS TARD, uniquement dans backend/.env
SMS_API_KEY=

# Paiements — désactivés tant que l'étape É6 n'est pas faite
CREDITS_ENABLED=False
PAYMENT_PROVIDER=fake
# Variables CamPay : à remplir PLUS TARD, uniquement ici (jamais dans le code ni dans une conversation)
CAMPAY_ENV=DEV
CAMPAY_APP_USERNAME=
CAMPAY_APP_PASSWORD=
CAMPAY_WEBHOOK_KEY=
