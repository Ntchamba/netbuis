# Copier en backend/.env — ce fichier ne contient AUCUN secret réel.
DEBUG=True
SECRET_KEY=dev-only-insecure-key-change-me-0000
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://UTILISATEUR:change-me@localhost:5432/netbuis
CORS_ALLOWED_ORIGINS=http://localhost:5173

# SMS (OTP) : console (développement, exige DEBUG=True) | real (fournisseur réel, pas encore choisi)
SMS_PROVIDER=console
# Clé du fournisseur SMS réel : à remplir PLUS TARD, uniquement dans backend/.env
SMS_API_KEY=

# Paiements — désactivés tant que l'étape É6 n'est pas faite
CREDITS_ENABLED=False
PAYMENT_PROVIDER=fake
# Variables CamPay : à remplir PLUS TARD, uniquement ici (jamais dans le code ni dans une conversation)
CAMPAY_ENV=DEV
CAMPAY_APP_USERNAME=
CAMPAY_APP_PASSWORD=
CAMPAY_WEBHOOK_KEY=

# --- Production (déploiement reporté) : variables OBLIGATOIRES avec config.settings.prod ---
# SECRET_KEY (>= 32 caractères, aléatoire), ALLOWED_HOSTS, CORS_ALLOWED_ORIGINS et
# CSRF_TRUSTED_ORIGINS (https:// seulement, sans joker).
# Facultatives : UPLOAD_SIGNING_KEY (>= 32), NUM_PROXIES (1 derrière Railway),
# SECURE_HSTS_INCLUDE_SUBDOMAINS, SECURE_HSTS_PRELOAD, API_DOCS_ENABLED (faux par défaut),
# DJANGO_ADMIN_PATH (admin Django désactivé tant qu'un chemin d'au moins 12 caractères n'est pas donné).
