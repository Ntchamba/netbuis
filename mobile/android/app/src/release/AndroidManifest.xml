<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- T121 : permissions qu'un paquet (Jitsi Meet SDK, caméra, appel) pourrait ajouter au manifeste
         fusionné et dont NetBuis n'a pas besoin. Appel audio seul, vidéo coupée (kJitsiConfig), pas
         d'intégration au téléphone (callIntegrationEnabled=false), pas de localisation, photos prises
         par l'application Appareil photo du téléphone (image_picker, intention système).
         Placées ici (src/release, src/profile, src/debug) et non dans src/main, dont le test
         call_data_test vérifie qu'il ne cite aucune permission « Téléphone ». -->
    <uses-permission android:name="android.permission.CAMERA" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_PHONE_STATE" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" tools:node="remove"/>
    <uses-permission android:name="android.permission.CALL_PHONE" tools:node="remove"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove"/>
</manifest>
